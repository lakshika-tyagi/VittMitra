# ==============================================================================
# VittMitra Environment Configuration Template
# Duplicate this file as .env in your local environment and fill in the values.
# NEVER commit .env with secrets or production credentials to source control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME=VittMitra
SECRET_KEY=change-this-in-production-to-a-secure-random-secret

# Frontend Configuration
NEXT_PUBLIC_APP_NAME=VittMitra
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_ENVIRONMENT=development

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL + PostGIS Database Configuration
DATABASE_URL=postgresql+asyncpg://vittmitra_user:vittmitra_password@localhost:5432/vittmitra_db
POSTGRES_USER=vittmitra_user
POSTGRES_PASSWORD=vittmitra_password
POSTGRES_DB=vittmitra_db
POSTGRES_PORT=5432

# AI Services & LLM (Google Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Bhashini / Multilingual Language Services (Future Milestones)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
